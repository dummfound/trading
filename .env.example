# Local Express backend
PORT=3001

# Bybit API (kept server-side only — never expose to the browser)
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret

# Cursor Pro SDK (preferred validator) — https://cursor.com/dashboard
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# Fast OpenAI-compatible fallback (often wins the 1s race)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Hard deadline for AI validation of BUY/SELL (ms)
AI_VALIDATE_TIMEOUT_MS=1000

# Auto-entry thresholds
AUTO_MIN_CONF_AI=0.55
AUTO_MIN_CONF_HEURISTIC=0.72
AUTO_COOLDOWN_MS=180000
